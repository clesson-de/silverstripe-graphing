{
    "name": "clesson-de/silverstripe-graphing",
    "description": "Chart form fields for Silverstripe 6 CMS, rendered with Chart.js. Display-only — no data storage.",
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "keywords": ["silverstripe", "charts", "chart.js", "graphing", "forms"],
    "authors": [
        {
            "name": "Kai Feldmaier",
            "email": "kai.feldmaier@clesson.de",
            "homepage": "https://clesson.de"
        }
    ],
    "require": {
        "php": "^8.1",
        "silverstripe/framework": "^6",
        "silverstripe/admin": "^3"
    },
    "autoload": {
        "psr-4": {
            "Clesson\\Silverstripe\\Graphing\\": "src/"
        }
    },
    "extra": {
        "expose": [
            "client/admin/dist"
        ]
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}

